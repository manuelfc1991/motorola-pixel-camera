<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer concentric ring -->
    <item>
        <shape android:shape="oval">
            <size android:width="86dp" android:height="86dp" />
            <stroke android:width="3.5dp" android:color="@color/pixel_shutter_outer" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
    <!-- Inner solid button -->
    <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/pixel_shutter_inner" />
        </shape>
    </item>
</layer-list>
