<?xml version="1.0" encoding="utf-8"?>
<!-- Night Sight: dark disc with a white moon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="3.2dp" android:color="#FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:bottom="9.6dp" android:left="9.6dp" android:right="9.6dp" android:top="9.6dp">
        <shape android:shape="oval"><solid android:color="#1A1C18" /></shape>
    </item>
    <item android:bottom="27dp" android:drawable="@drawable/ic_moon" android:left="27dp" android:right="27dp" android:top="27dp" />
</layer-list>
