<?xml version="1.0" encoding="utf-8"?>
<!-- Recording: white ring with a red stop square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="3.2dp" android:color="#FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:bottom="26dp" android:left="26dp" android:right="26dp" android:top="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2564B" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
