<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixel_black">

    <!-- Camera Preview Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomControlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar" />

    <!-- Top Status & Quick Settings Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/pixel_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Settings Gear Icon -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_container"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_settings" />

        <TextView
            android:id="@+id/tvHdrBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_container"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="HDR+ ON"
            android:textColor="@color/pixel_accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRawBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_container"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="RAW"
            android:textColor="@color/pixel_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv108MpBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_container"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="108MP"
            android:textColor="@color/pixel_text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSensorInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="108MP HM2"
            android:textColor="@color/pixel_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Horizon Level Indicator (Pixel Style) -->
    <LinearLayout
        android:id="@+id/horizonLevelIndicator"
        android:layout_width="160dp"
        android:layout_height="24dp"
        android:alpha="0.6"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/viewFinder">

        <View
            android:layout_width="32dp"
            android:layout_height="1.5dp"
            android:background="@color/pixel_accent_yellow" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/ic_focus_ring" />

        <View
            android:layout_width="32dp"
            android:layout_height="1.5dp"
            android:background="@color/pixel_accent_yellow" />
    </LinearLayout>

    <!-- Real-time RGB Histogram Overlay -->
    <com.motorola.pixelcamera.ui.HistogramView
        android:id="@+id/histogramView"
        android:layout_width="120dp"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar" />

    <!-- Tap to Focus Animated Reticle Container (with exposure slider) -->
    <LinearLayout
        android:id="@+id/focusReticleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/focusRing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_focus_ring" />

        <!-- Vertical Sun Exposure Control beside Focus Ring -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pill_container"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_exposure_sun" />

            <View
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:background="@color/pixel_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- NIGHT SIGHT OVERLAY: Circular Hold Still Countdown -->
    <LinearLayout
        android:id="@+id/overlayNightHoldStill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_container"
        android:backgroundTint="#CC121316"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/viewFinder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/viewFinder"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/pixel_accent_yellow" />

        <TextView
            android:id="@+id/tvNightTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1.8s"
            android:textColor="@color/pixel_accent_yellow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold still • Capturing light"
            android:textColor="@color/pixel_text_white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- PORTRAIT MODE APERTURE SLIDER OVERLAY -->
    <LinearLayout
        android:id="@+id/overlayPortraitAperture"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_container"
        android:backgroundTint="#DD181A1D"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/zoomPillContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvApertureLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="f / 1.8"
            android:textColor="@color/pixel_accent_yellow"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbAperture"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:max="100"
            android:progress="70"
            android:progressTint="@color/pixel_accent_yellow"
            android:thumbTint="@color/pixel_accent_yellow" />

        <TextView
            android:id="@+id/tvBokehPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Blur 70%"
            android:textColor="@color/pixel_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Processing Toast Pill -->
    <LinearLayout
        android:id="@+id/processingPill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_container"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/proControlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/pixel_accent_yellow" />

        <TextView
            android:id="@+id/tvProcessingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/hdr_processing"
            android:textColor="@color/pixel_text_white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Pro Manual Controls Drawer (ISO, EV) -->
    <LinearLayout
        android:id="@+id/proControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DD121316"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/zoomPillContainer"
        tools:visibility="visible">

        <!-- ISO Slider Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvIsoLabel"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="ISO AUTO"
                android:textColor="@color/pixel_accent_yellow"
                android:textSize="12sp"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/sbIso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="192"
                android:progress="0"
                android:progressTint="@color/pixel_accent_yellow"
                android:thumbTint="@color/pixel_accent_yellow" />
        </LinearLayout>

        <!-- EV Slider Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvEvLabel"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="EV 0.0"
                android:textColor="@color/pixel_text_white"
                android:textSize="12sp"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/sbEv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="@color/pixel_accent_blue"
                android:thumbTint="@color/pixel_accent_blue" />
        </LinearLayout>
    </LinearLayout>

    <!-- Zoom Switcher (.6x, 1x, 2x) -->
    <LinearLayout
        android:id="@+id/zoomPillContainer"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_container"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/modeCarousel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnZoomUltrawide"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/zoom_ultrawide"
            android:textColor="@color/pixel_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnZoom1x"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_container"
            android:backgroundTint="@color/pixel_pill_active"
            android:gravity="center"
            android:text="@string/zoom_1x"
            android:textColor="@color/pixel_pill_text_active"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnZoom2x"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/zoom_2x"
            android:textColor="@color/pixel_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mode Carousel (Night Sight, Portrait, Camera, Video, Pro) -->
    <HorizontalScrollView
        android:id="@+id/modeCarousel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/pixel_black"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottomControlPanel">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/modeNightSight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/mode_night_sight"
                android:textColor="@color/pixel_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/modePortrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/mode_portrait"
                android:textColor="@color/pixel_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/modeCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_container"
                android:backgroundTint="@color/pixel_pill_active"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="@string/mode_camera"
                android:textColor="@color/pixel_pill_text_active"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/mode_video"
                android:textColor="@color/pixel_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/modePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/mode_pro"
                android:textColor="@color/pixel_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Controls (Gallery Thumbnail, Shutter Button, Switch Camera) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlPanel"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@color/pixel_black"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivGalleryThumbnail"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="32dp"
            android:background="@drawable/bg_pill_container"
            android:padding="2dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnShutter"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/bg_shutter_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_pill_container"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_switch_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
