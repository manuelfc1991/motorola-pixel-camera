<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixel_black"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="@color/pixel_text_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Device Hardware Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_container"
                android:backgroundTint="#1F2430"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motorola Edge 20 Fusion"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="MediaTek Dimensity 800U • 108MP HM2 Sensor"
                    android:textColor="@color/pixel_accent_blue"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- GENERAL CATEGORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="GENERAL"
                android:textColor="@color/pixel_accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_container"
                android:backgroundTint="#181A1D"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Save location\nAdd GPS coordinates to EXIF"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSounds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Camera sounds\nShutter click audio"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- COMPUTATIONAL PHOTOGRAPHY CATEGORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="COMPUTATIONAL PHOTOGRAPHY"
                android:textColor="@color/pixel_accent_yellow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_container"
                android:backgroundTint="#181A1D"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="RAW + JPEG control\nSave 10-bit DNG alongside processed JPEG"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <!-- HDR+ Frame Count Slider -->
                <TextView
                    android:id="@+id/tvHdrFramesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HDR+ Frame Count: 18 frames"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Higher frame counts eliminate noise on hair and foliage"
                    android:textColor="@color/pixel_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbHdrFrames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="25"
                    android:min="5"
                    android:progress="18"
                    android:progressTint="@color/pixel_accent_yellow"
                    android:thumbTint="@color/pixel_accent_yellow" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <!-- Color Saturation Tuning Slider -->
                <TextView
                    android:id="@+id/tvSaturationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color Saturation: 1.00x"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vibrancy &amp; chroma punch in processed JPEG"
                    android:textColor="@color/pixel_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSaturation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="150"
                    android:min="50"
                    android:progress="100"
                    android:progressTint="@color/pixel_accent_blue"
                    android:thumbTint="@color/pixel_accent_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <!-- Micro-Contrast Tuning Slider -->
                <TextView
                    android:id="@+id/tvMicroContrastLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Micro-Contrast: 1.00x"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pixel Hermite tone curve local dynamic depth"
                    android:textColor="@color/pixel_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbMicroContrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="150"
                    android:min="50"
                    android:progress="100"
                    android:progressTint="@color/pixel_accent_blue"
                    android:thumbTint="@color/pixel_accent_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <!-- Noise-Cored Sharpening Slider -->
                <TextView
                    android:id="@+id/tvSharpnessLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edge Sharpening: 1.00x"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8-neighbor omnidirectional detail boost with anti-halo"
                    android:textColor="@color/pixel_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSharpness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="200"
                    android:min="0"
                    android:progress="100"
                    android:progressTint="@color/pixel_accent_blue"
                    android:thumbTint="@color/pixel_accent_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swUltraHdr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Ultra HDR capture\nRetain highlight dynamic range for OLED"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- HARDWARE TUNING (MOTO EDGE 20 FUSION) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="HARDWARE TUNING (KYOTO)"
                android:textColor="@color/pixel_indicator_glow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_container"
                android:backgroundTint="#181A1D"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw108MpRemosaic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="108 MP Remosaic Trigger\nHook vendor remosaic scenario on HM2"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temporal De-Noise Floor: Mild (0.4x)"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preserves real texture details without watercolor smudging"
                    android:textColor="@color/pixel_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- VIDEO CATEGORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="VIDEO RECORDING"
                android:textColor="@color/pixel_accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_container"
                android:backgroundTint="#181A1D"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swEis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Video stabilization (EIS)\nGyroscope-assisted shake reduction"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#26282E" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swHevc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Store videos efficiently (HEVC)\nH.265 hardware encoding via MTK Codec2"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ABOUT FOOTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pixel Camera (kyoto edition)"
                    android:textColor="@color/pixel_text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version 9.4.103 • Apache 2.0 Open Source"
                    android:textColor="@color/pixel_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
