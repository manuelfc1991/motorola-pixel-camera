<resources>
    <style name="Theme.MotorolaPixelCamera" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pixel_accent_blue</item>
        <item name="colorSecondary">@color/pixel_accent_blue</item>
        <item name="android:statusBarColor">@color/pixel_black</item>
        <item name="android:navigationBarColor">@color/pixel_black</item>
    </style>

    <style name="Theme.MotorolaPixelCamera.Fullscreen" parent="Theme.MotorolaPixelCamera">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="StatusChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_pill_container</item>
        <item name="android:backgroundTint">@color/pixel_accent_blue</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:textColor">@color/pixel_pill_text_active</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
